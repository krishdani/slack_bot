# Slack credentials — copy this file to `.env` and fill in real values.
# Never commit the real .env file.

# Bot User OAuth Token (starts with xoxb-) from OAuth & Permissions.
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here


# Signing Secret from Basic Information > App Credentials.
SLACK_SIGNING_SECRET=your-slack-signing-secret-here



# --- Optional second bot: separate REPLY bot (two sidebar bots) ------------
# Two sidebar bots need two Slack apps with two DIFFERENT tokens (a token can't
# be shared). Set these to run a separate REPLY bot for the AI reply-suggestion
# feature on /slack/reply-events; this primary app keeps doing everything else
# (joins + moderation + daily report). Leave both blank to keep everything on
# one bot (default). The reply bot subscribes to message.channels/message.groups
# and needs its own scopes: chat:write, im:write, channels:history,
# channels:read, groups:history, groups:read, users:read.
REPLY_SLACK_BOT_TOKEN=
REPLY_SLACK_SIGNING_SECRET=


# --- Optional third bot: separate RELAY bot (the "copy me every message" app)
# Its own Slack app, token and signing secret, serving /slack/relay-events. Its
# only job is to DM the handler a copy of every message posted in any channel.
# Setting RELAY_SLACK_BOT_TOKEN also turns the relay feature ON by default (see
# MESSAGE_RELAY_ENABLED below). Leave both blank and the relay stays off unless
# you enable it explicitly, in which case the primary bot sends it instead.
# Subscribe it to message.channels + message.groups, and give it the scopes:
# chat:write, im:write, channels:history, channels:read, groups:history,
# groups:read, users:read.
RELAY_SLACK_BOT_TOKEN=
RELAY_SLACK_SIGNING_SECRET=


# Slack user ID of the community handler / Human POC (U...). Receives the daily
# report AND every real-time alert. Find it via the member's profile >
# "Copy member ID". HANDLER_SLACK_USER is the preferred name; HUMAN_POC_USER_ID
# is still honoured for backward compatibility. Set one of them.

HUMAN_POC_USER_ID=U01234567AB


# Shared secret protecting the /tasks/* endpoints. If unset, they're open
# (use only for local testing). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
DIGEST_TRIGGER_TOKEN=your-digest-trigger-token-here



# How many hours of history the daily report covers (optional, default 24).
DAILY_WINDOW_HOURS=24

# --- AI understanding (OPTIONAL) ------------------------------------------
# If set, the report uses OpenAI to judge whether messages fit their channel
# and whether they need a reply (smarter than keywords). Used only at report
# time and batched to keep token use low. Leave OPENAI_API_KEY blank to use
# the keyword heuristics instead.
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
AI_CLASSIFICATION=on
AI_BATCH_SIZE=40

# --- Real-time alerts (OPTIONAL) ------------------------------------------
# DM the handler the moment a new member joins. Turning this off does not
# affect the daily report — joins are still recorded and still listed there.
REALTIME_MEMBER_ALERTS=on

# Add a "Send welcome DM" button to that new-member alert. When the handler
# clicks it, the bot DMs the new joiner a fixed welcome message (first name
# filled in). To use it, enable Interactivity in the Slack app and set the
# Request URL to https://<your-host>/slack/interactivity. The bot also needs
# chat:write + im:write scopes to DM the joiner. Turn off for a plain alert.
WELCOME_DM_ENABLED=on

# --- Real-time channel moderation (OPTIONAL) -------------------------------
# Evaluate every channel message against its purpose (see channel_rules.py) and
# DM the handler when it doesn't belong. The bot never replies in the channel.
MODERATION_ENABLED=on

# Only alert when the verdict is at least this confident (0.0-1.0). Raise it if
# the handler gets too many alerts; lower it to catch more.
MODERATION_CONFIDENCE_THRESHOLD=0.7

# Skip messages shorter than this ("thanks", "+1") — no signal, wasted tokens.
MODERATION_MIN_CHARS=15

# Moderate channels that have no entry in channel_rules.py, using a generic rule.
MODERATE_UNCONFIGURED_CHANNELS=off

# Moderate replies inside threads (their fit is really the parent's fit).
MODERATE_THREAD_REPLIES=off

# --- Reply suggestions (OPTIONAL) ------------------------------------------
# For every channel message, draft a reply the handler could send and DM it to
# them. Independent of moderation. WARNING: with the defaults below this fires
# on EVERY message — high DM volume and OpenAI cost in an active workspace.
REPLY_SUGGESTIONS_ENABLED=on

# Skip messages shorter than this before drafting (0 = draft for everything,
# including "thanks" and one-word posts). 15 skips short noise like "thanks"
# and "+1". Raise it further to cut more volume + cost.
REPLY_SUGGESTIONS_MIN_CHARS=15

# Draft replies for thread replies too, not just top-level messages.
REPLY_SUGGESTIONS_INCLUDE_THREADS=on

# --- Message relay (OPTIONAL) ----------------------------------------------
# DM the handler a copy of EVERY message posted in any channel: who, where,
# when, and the text. No AI and no filtering — that is the point. Defaults to on
# when RELAY_SLACK_BOT_TOKEN is set, off otherwise. Set it explicitly to
# override either way.
MESSAGE_RELAY_ENABLED=on

# Relay messages shorter than this? 0 = relay everything, including "thanks"
# and a lone emoji. Raise it to filter short noise out of the handler's DMs.
MESSAGE_RELAY_MIN_CHARS=0

# Relay thread replies too, not just top-level messages.
MESSAGE_RELAY_INCLUDE_THREADS=on

# Relay posts made by other apps/bots. Off by default: "someone posted" means a
# human, and app chatter would flood the handler.
MESSAGE_RELAY_INCLUDE_BOTS=off

# Retries before giving up on a call (moderation then falls back to heuristics).
AI_MAX_RETRIES=2
SLACK_MAX_RETRIES=3

# Worker threads for off-request work (AI calls, DMs). Slack needs a fast ack.
BACKGROUND_WORKERS=4

# Where the SQLite file lives (optional, default bot_data.db).
DB_PATH=bot_data.db

# Local dev port (optional; Render sets PORT automatically).
PORT=3000
